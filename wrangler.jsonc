{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "murthymalapaka-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  }
  ,
  // Visiting-network log: written by worker/edge-log.js, read back by
  // /api/cloudflare. Analytics Engine must be ENABLED on the account and the
  // dataset must exist, or wrangler fails the whole deploy — that is what
  // blocked #49 ("You need to enable Analytics Engine"). See
  // ANALYTICS-SETUP.md §5d before touching this.
  "analytics_engine_datasets": [
    { "binding": "VISITS", "dataset": "mm_site_visits" }
  ]
}
