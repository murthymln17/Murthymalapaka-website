{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "murthymalapaka-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  }
  // The visiting-network log (worker/edge-log.js) needs the binding below.
  // It is commented out because the deploy that introduced it did not
  // publish — a binding the account cannot provision fails `wrangler
  // deploy` outright, taking the whole site's deploy with it. The logging
  // code stays in place and no-ops without the binding; restore these
  // lines once Analytics Engine is confirmed available on the account,
  // and the card fills from the next page view.
  //
  // ,"analytics_engine_datasets": [
  //   { "binding": "VISITS", "dataset": "mm_site_visits" }
  // ]
}
